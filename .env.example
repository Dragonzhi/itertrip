# IterTrip 服务端配置模板。复制为 .env 并填入真实值：
#   cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交到 Git；服务器部署时手动创建/上传一份。

# 内置免费供应商（可选）：用户未配置自己的 key 时，后端自动用它兜底
# 不填 ITERTRIP_FREE_API_KEY = 不启用免费兜底，未配置时走 mock 演示模式
ITERTRIP_FREE_API_KEY=
ITERTRIP_FREE_BASE_URL=https://api.dragonzhi.xyz
ITERTRIP_FREE_MODEL=openrouter/free

# 后台管理 token（可选）：设置后访问 /admin?admin_token=<值> 可在线管理免费 AI 服务配置
# 不设置则后台接口整体关闭（403）
ITERTRIP_ADMIN_TOKEN=

# 服务端通用 LLM 配置（可选，优先级高于免费供应商）：
# ITERTRIP_LLM_API_KEY=
# ITERTRIP_LLM_BASE_URL=https://api.deepseek.com
# ITERTRIP_LLM_MODEL=deepseek-chat
