# IterTrip 服务端配置模板。复制为 .env 并填入真实值：
#   cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交到 Git；服务器部署时手动创建/上传一份。

# 内置免费供应商（可选）：用户未配置自己的 key 时，后端自动用它兜底
# 不填 ITERTRIP_FREE_API_KEY = 不启用免费兜底，未配置时走 mock 演示模式
ITERTRIP_FREE_API_KEY=
ITERTRIP_FREE_BASE_URL=https://api.dragonzhi.xyz
ITERTRIP_FREE_MODEL=openrouter/free

# 后台管理 token（可选）：设置后访问 /admin?admin_token=<值> 可在线管理免费 AI 服务配置
# 不设置则后台接口整体关闭（403）
ITERTRIP_ADMIN_TOKEN=

# 服务端通用 LLM 配置（可选，优先级高于免费供应商）：
# ITERTRIP_LLM_API_KEY=
# ITERTRIP_LLM_BASE_URL=https://api.deepseek.com
# ITERTRIP_LLM_MODEL=deepseek-chat

# 高德 Web 服务 key（可选）：坐标补全的 POI 兜底（店名级精度，需在高德开放平台申请）
# ITERTRIP_AMAP_KEY=

# ---------- M18 旅行记忆库（RAG，默认关闭）----------
# 开启后：成功提取的攻略会切分入库，下次同目的地对话检索【记忆参考】带引用回答；
# 编辑器里手动改过的坐标入「实体记忆」，后续同名地点 geocode 直接命中（免 LLM 猜测）。
# 隐私说明：攻略原文会从「只在本机浏览器」变为「进服务器库存」，按匿名档案（X-Traveler-Id）隔离，
# 设置面板可一键清空自己的全部记忆；因此默认关闭，由部署者显式开启。
ITERTRIP_MEMORY_ENABLED=0

# embedding 来源：local=fastembed 本地 ONNX（默认，需额外依赖）；api=OpenAI 兼容 /embeddings
ITERTRIP_EMBED_PROVIDER=local
# ITERTRIP_EMBED_MODEL=BAAI/bge-small-zh-v1.5
# provider=api 时必填：
# ITERTRIP_EMBED_BASE_URL=
# ITERTRIP_EMBED_API_KEY=

# 记忆库单文件路径（可选，默认项目根 memory.sqlite；已 gitignore）
# ITERTRIP_MEMORY_DB=

# provider=local 需先装可选依赖：pip install fastembed（含 onnxruntime，约几十 MB）
# 首次运行会从 HuggingFace 拉约 100MB 模型；国内服务器请设镜像（设了该变量会自动关闭 Xet 下载协议）：
# HF_ENDPOINT=https://hf-mirror.com
